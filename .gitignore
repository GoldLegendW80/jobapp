# Secrets: .env and every variant, the template stays tracked
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# JavaScript
node_modules/
dist/
build/
.vite/
playwright-report/
test-results/
.vitest/

# OS and editors
.DS_Store
.idea/
.vscode/

# Claude Code: the project config (.claude/settings.json, agents/, commands/) is versioned;
# agent worktrees, review drafts and personal settings stay on each machine
.claude/worktrees/
.claude/reviews/
.claude/settings.local.json

# Database dumps: pulled by ./deploy.sh backup --pull, never committed
backups/
*.dump

# Records and logs of ops/local-check.sh (the batch check): local to this machine
.local-check/
