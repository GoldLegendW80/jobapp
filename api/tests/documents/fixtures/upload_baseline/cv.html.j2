{#- classic: the command line's layout re-expressed. A header with the photo, the name, the
    headline and the contact lines between two rules, then one row per section: its label in a
    narrow column on the left, its body on the right. An empty section is not printed. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<div class="bar"></div>
{{ base.header(content.headline) }}
<div class="bar"></div>

{% if content.summary or content.highlights or content.competencies %}
<section class="row">
<h2 class="label">{{ base.label("summary") }}</h2>
<div class="body">
{% if content.summary %}<p class="summary">{{ content.summary }}</p>{% endif %}
{% if content.highlights or content.competencies %}
<div class="about-cols">
{% if content.highlights %}
<div>
<h3 class="sub">{{ base.label("highlights") }}</h3>
{{ base.bullets(content.highlights) }}
</div>
{% endif %}
{% if content.competencies %}
<div>
<h3 class="sub">{{ base.label("competencies") }}</h3>
{{ base.bullets(content.competencies, "competencies") }}
</div>
{% endif %}
</div>
{% endif %}
</div>
</section>
{% endif %}

{% if roles %}
<section class="row">
<h2 class="label">{{ base.label("experience") }}</h2>
<div class="body">
{% for role in roles %}
{{ base.employer(role) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if schools %}
<section class="row">
<h2 class="label">{{ base.label("education") }}</h2>
<div class="body schools">
{% for item in schools %}
{{ base.school(item) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if content.skills %}
<section class="row">
<h2 class="label">{{ base.label("skills") }}</h2>
<div class="body skills">
{% for group in content.skills %}
{{ base.skill_group(group) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if languages %}
<section class="row">
<h2 class="label">{{ base.label("languages") }}</h2>
<div class="body">
<ul class="languages">
{% for item in languages %}
{{ base.language(item) }}
{% endfor %}
</ul>
</div>
</section>
{% endif %}
{% endblock %}
