{#- cards: every section on a soft card with round corners, and each role of the experience on a
    card of its own (the first one carries the heading). The heading card across the top (the
    photo on its left when there is one, the name, the headline, the contact lines), then two
    columns: the profile, the achievements and the experience on the left, the key competencies,
    the education, the skills and the languages on the right. The left column comes first in the
    document, so the text reads the story before the details. A card never splits across the
    end of a page: it moves to the next one whole. An empty section is not printed. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<header class="card head">
{{ base.portrait() }}
<div class="headtext">
<h1 class="name">{{ base.words(name, "w") }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
{{ base.contact_lines() }}
</div>
</header>
<div class="columns">
<main class="main">
{% if content.summary %}
<section class="card">
<h2 class="label">{{ base.label("summary") }}</h2>
<p class="summary">{{ content.summary }}</p>
</section>
{% endif %}
{% if content.highlights %}
<section class="card">
<h2 class="label">{{ base.label("highlights") }}</h2>
{{ base.bullets(content.highlights, "highlights") }}
</section>
{% endif %}
{% if roles %}
<section class="roles">
{% for role in roles %}
<div class="card">
{% if loop.first %}<h2 class="label">{{ base.label("experience") }}</h2>{% endif %}
{{ base.employer(role) }}
</div>
{% endfor %}
</section>
{% endif %}
</main>
<aside class="side">
{% if content.competencies %}
<section class="card">
<h2 class="label">{{ base.label("competencies") }}</h2>
{{ base.bullets(content.competencies, "competencies") }}
</section>
{% endif %}
{% if schools %}
<section class="card">
<h2 class="label">{{ base.label("education") }}</h2>
{% for item in schools %}
{{ base.school(item) }}
{% endfor %}
</section>
{% endif %}
{% if content.skills %}
<section class="card">
<h2 class="label">{{ base.label("skills") }}</h2>
{% for group in content.skills %}
{{ base.skill_group(group) }}
{% endfor %}
</section>
{% endif %}
{% if languages %}
<section class="card">
<h2 class="label">{{ base.label("languages") }}</h2>
<ul class="languages">
{% for item in languages %}
{{ base.language(item) }}
{% endfor %}
</ul>
</section>
{% endif %}
</aside>
</div>
{% endblock %}
