{#- sidebar, the letter: the CV's tinted column with the photo and the contact lines, and on the
    right the name, the date, the recipient, the subject, the salutation, the paragraphs, the
    closing and the signature. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<div class="page">
<aside class="side">
{{ base.portrait() }}
{% if contact %}
<section class="block">
<h2 class="label">{{ base.label("contact") }}</h2>
{{ base.contact_lines() }}
</section>
{% endif %}
</aside>
<main class="main">
<header class="head">
<h1 class="name">{{ name }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
</header>
<div class="letter-body">
{{ base.letter_date() }}
{% if content.recipient %}<p class="recipient">{{ content.recipient }}</p>{% endif %}
{% if content.subject %}<p class="subject"><strong>{{ base.label("subject") }}</strong> {{ content.subject }}</p>{% endif %}
{% if content.salutation %}<p class="salutation">{{ content.salutation }}</p>{% endif %}
{{ base.paragraphs(content.paragraphs) }}
{% if content.closing %}<p class="closing">{{ content.closing }}</p>{% endif %}
<p class="signature">{{ name }}</p>
</div>
</main>
</div>
{% endblock %}
