{#- minimal: one column, monochrome, generous white space. The name large and light on top with
    the headline and the contact lines, then each section under a small spaced heading that a
    hairline continues to the right edge: the profile, the achievements, the key competencies in
    three columns, the experience, the education, the skills as one line per group and the
    languages. An empty section is not printed. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<header class="head">
<h1 class="name">{{ name }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
{{ base.contact_lines() }}
</header>

{% if content.summary %}
<section class="block">
<h2 class="label">{{ base.label("summary") }}</h2>
<div class="body"><p class="summary">{{ content.summary }}</p></div>
</section>
{% endif %}

{% if content.highlights %}
<section class="block">
<h2 class="label">{{ base.label("highlights") }}</h2>
<div class="body">{{ base.bullets(content.highlights, "highlights") }}</div>
</section>
{% endif %}

{% if content.competencies %}
<section class="block">
<h2 class="label">{{ base.label("competencies") }}</h2>
<div class="body">{{ base.bullets(content.competencies, "competencies") }}</div>
</section>
{% endif %}

{% if roles %}
<section class="block">
<h2 class="label">{{ base.label("experience") }}</h2>
<div class="body">
{% for role in roles %}
{{ base.employer(role) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if schools %}
<section class="block">
<h2 class="label">{{ base.label("education") }}</h2>
<div class="body">
{% for item in schools %}
{{ base.school(item) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if content.skills %}
<section class="block">
<h2 class="label">{{ base.label("skills") }}</h2>
<div class="body">
{% for group in content.skills %}
{{ base.skill_group(group) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if languages %}
<section class="block">
<h2 class="label">{{ base.label("languages") }}</h2>
<div class="body">
<ul class="languages">
{% for item in languages %}
{{ base.language(item) }}
{% endfor %}
</ul>
</div>
</section>
{% endif %}
{% endblock %}
