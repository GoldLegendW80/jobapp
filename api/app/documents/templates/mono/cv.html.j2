{#- mono: one column for engineering profiles. The name in the monospace face over the headline
    and the contact lines, then each section under a monospace heading with a hash mark: the
    profile, the achievements, the key competencies in two columns, the experience (the
    organisations and the dates in the monospace face), the education, the skills in a tinted
    block set like code (one line per group) and the languages. An empty section is not
    printed. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<header class="head">
<h1 class="name">{{ name }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
{{ base.contact_lines() }}
</header>

{% if content.summary %}
<section class="block">
<h2 class="label">{{ base.label("summary") }}</h2>
<p class="summary">{{ content.summary }}</p>
</section>
{% endif %}

{% if content.highlights %}
<section class="block">
<h2 class="label">{{ base.label("highlights") }}</h2>
{{ base.bullets(content.highlights, "highlights") }}
</section>
{% endif %}

{% if content.competencies %}
<section class="block">
<h2 class="label">{{ base.label("competencies") }}</h2>
{{ base.bullets(content.competencies, "competencies") }}
</section>
{% endif %}

{% if roles %}
<section class="block">
<h2 class="label">{{ base.label("experience") }}</h2>
{% for role in roles %}
{{ base.employer(role) }}
{% endfor %}
</section>
{% endif %}

{% if schools %}
<section class="block">
<h2 class="label">{{ base.label("education") }}</h2>
<div class="schools">
{% for item in schools %}
{{ base.school(item) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if content.skills %}
<section class="block">
<h2 class="label">{{ base.label("skills") }}</h2>
<div class="code">
{% for group in content.skills %}
{{ base.skill_group(group) }}
{% endfor %}
</div>
</section>
{% endif %}

{% if languages %}
<section class="block">
<h2 class="label">{{ base.label("languages") }}</h2>
<ul class="languages">
{% for item in languages %}
{{ base.language(item) }}
{% endfor %}
</ul>
</section>
{% endif %}
{% endblock %}
