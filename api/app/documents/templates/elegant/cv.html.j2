{#- elegant: one column inside a thin double frame drawn on every page. The contact lines in a row
    over the name as a letterhead, the name in a display serif, the headline in italics; each
    section under an italic display heading that runs into a hairline: the profile, the
    achievements between two rules, the key competencies in two columns over hairlines, the
    experience, the education, the skills as ruled rows and the languages. An empty section is not
    printed. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<div class="frame"></div>
<header class="head">
<div class="headtext">
<h1 class="name">{{ base.words(name, "w") }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
</div>
{{ base.contact_lines() }}
</header>

{% if content.summary %}
<section class="block">
<h2 class="label">{{ base.label("summary") }}</h2>
<p class="summary">{{ content.summary }}</p>
</section>
{% endif %}

{% if content.highlights %}
<section class="block">
<h2 class="label">{{ base.label("highlights") }}</h2>
{{ base.bullets(content.highlights, "highlights") }}
</section>
{% endif %}

{% if content.competencies %}
<section class="block">
<h2 class="label">{{ base.label("competencies") }}</h2>
{{ base.bullets(content.competencies, "competencies") }}
</section>
{% endif %}

{% if roles %}
<section class="block">
<h2 class="label">{{ base.label("experience") }}</h2>
{% for role in roles %}
{{ base.employer(role) }}
{% endfor %}
</section>
{% endif %}

{% if schools %}
<section class="block">
<h2 class="label">{{ base.label("education") }}</h2>
{% for item in schools %}
<div class="school">
<div class="entry-head">
<h3 class="entry-title">{{ item.degree }}{% if item.degree and item.school %}, {% endif %}<span class="org">{{ item.school }}</span></h3>
{% if item.period %}<p class="period">{{ item.period }}</p>{% endif %}
</div>
{% if item.location %}<p class="place">{{ item.location }}</p>{% endif %}
</div>
{% endfor %}
</section>
{% endif %}

{% if content.skills %}
<section class="block">
<h2 class="label">{{ base.label("skills") }}</h2>
{% for group in content.skills %}
{{ base.skill_group(group) }}
{% endfor %}
</section>
{% endif %}

{% if languages %}
<section class="block">
<h2 class="label">{{ base.label("languages") }}</h2>
<ul class="languages">
{% for item in languages %}
{{ base.language(item) }}
{% endfor %}
</ul>
</section>
{% endif %}
{% endblock %}
