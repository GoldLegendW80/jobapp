{#- portrait: a large photo at the top left and, beside it, the name set large, the headline
    and the contact lines. Without a photo the frame holds the initials of the name, never an
    empty frame; without a name either, there is no frame. The name comes first in the document
    and the grid puts the frame on its left, so a text extractor reads the name first. Then one
    column of sections under serif headings. An empty section is not printed. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
{% set parts = name.split() %}
{% set initials = ((parts[0][:1] ~ (parts[-1][:1] if parts | length > 1 else "")) | upper) if parts else "" %}
<header class="head{% if not photo and not initials %} bare{% endif %}">
<div class="headtext">
<h1 class="name">{{ base.words(name) }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
{{ base.contact_lines() }}
</div>
{% if photo %}<div class="frame">{{ base.portrait() }}</div>{% elif initials %}<div class="frame initials">{{ initials }}</div>{% endif %}
</header>

{% if content.summary %}
<section class="block">
<h2 class="label">{{ base.label("summary") }}</h2>
<p class="summary">{{ content.summary }}</p>
</section>
{% endif %}

{% if content.highlights %}
<section class="block">
<h2 class="label">{{ base.label("highlights") }}</h2>
{{ base.bullets(content.highlights, "highlights") }}
</section>
{% endif %}

{% if content.competencies %}
<section class="block">
<h2 class="label">{{ base.label("competencies") }}</h2>
{{ base.bullets(content.competencies, "competencies") }}
</section>
{% endif %}

{% if roles %}
<section class="block">
<h2 class="label">{{ base.label("experience") }}</h2>
{% for role in roles %}
{{ base.employer(role) }}
{% endfor %}
</section>
{% endif %}

{% if schools %}
<section class="block">
<h2 class="label">{{ base.label("education") }}</h2>
{% for item in schools %}
{{ base.school(item) }}
{% endfor %}
</section>
{% endif %}

{% if content.skills %}
<section class="block">
<h2 class="label">{{ base.label("skills") }}</h2>
{% for group in content.skills %}
{{ base.skill_group(group) }}
{% endfor %}
</section>
{% endif %}

{% if languages %}
<section class="block">
<h2 class="label">{{ base.label("languages") }}</h2>
<ul class="languages">
{% for item in languages %}
{{ base.language(item) }}
{% endfor %}
</ul>
</section>
{% endif %}
{% endblock %}
