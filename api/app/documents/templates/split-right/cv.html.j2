{#- split-right: a header across the page (the name and the headline, the photo on the right
    when there is one) over a thick accent rule, then two columns: the main column on the left
    with the profile, the achievements and the experience, a narrow column on the right with the
    contact lines, the key competencies, the education, the skills and the languages. The main
    column comes first in the document, so a text extractor reads the story before the details.
    An empty section is not printed. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{#- A contact line longer than the narrow column holds whole: the lines set smaller, or past
    31 characters all under the headline. -#}
{% set longest = contact | map(attribute="text") | map("length") | max if contact else 0 %}
{% block body %}
<header class="head">
<div class="headtext">
<h1 class="name">{{ base.words(name) }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
{% if longest > 31 %}{{ base.contact_lines("contact across") }}{% endif %}
</div>
{{ base.portrait() }}
</header>
<div class="cols">
<main class="main">
{% if content.summary %}
<section class="block">
<h2 class="label">{{ base.label("summary") }}</h2>
<p class="summary">{{ content.summary }}</p>
</section>
{% endif %}
{% if content.highlights %}
<section class="block">
<h2 class="label">{{ base.label("highlights") }}</h2>
{{ base.bullets(content.highlights, "highlights") }}
</section>
{% endif %}
{% if roles %}
<section class="block">
<h2 class="label">{{ base.label("experience") }}</h2>
{% for role in roles %}
{{ base.employer(role) }}
{% endfor %}
</section>
{% endif %}
</main>
<aside class="side">
{% if contact and longest <= 31 %}
<section class="block">
<h2 class="side-label">{{ base.label("contact") }}</h2>
{{ base.contact_lines("contact small" if longest > 25 else "contact") }}
</section>
{% endif %}
{% if content.competencies %}
<section class="block">
<h2 class="side-label">{{ base.label("competencies") }}</h2>
{{ base.bullets(content.competencies, "competencies") }}
</section>
{% endif %}
{% if schools %}
<section class="block">
<h2 class="side-label">{{ base.label("education") }}</h2>
{% for item in schools %}
{{ base.school(item) }}
{% endfor %}
</section>
{% endif %}
{% if content.skills %}
<section class="block">
<h2 class="side-label">{{ base.label("skills") }}</h2>
{% for group in content.skills %}
{{ base.skill_group(group) }}
{% endfor %}
</section>
{% endif %}
{% if languages %}
<section class="block">
<h2 class="side-label">{{ base.label("languages") }}</h2>
<ul class="languages">
{% for item in languages %}
{{ base.language(item) }}
{% endfor %}
</ul>
</section>
{% endif %}
</aside>
</div>
{% endblock %}
