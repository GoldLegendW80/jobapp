{#- bold, the letter: the CV's heading (the very large name, the photo on its right when there is
    one, the headline, the contact lines, the thick rule), then the date, the recipient, the
    subject in heavy type, the salutation, the paragraphs, the closing and the name. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<header class="head">
<div class="headtext">
<h1 class="name{% if name | length > 60 %} longer{% elif name | length > 30 %} long{% endif %}">{{ base.words(name, "w") }}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
{{ base.contact_lines() }}
</div>
{{ base.portrait() }}
</header>
<div class="letter-body">
{{ base.letter_date() }}
{% if content.recipient %}<p class="recipient">{{ content.recipient }}</p>{% endif %}
{% if content.subject %}<p class="subject"><strong>{{ base.label("subject") }}</strong> {{ content.subject }}</p>{% endif %}
{% if content.salutation %}<p class="salutation">{{ content.salutation }}</p>{% endif %}
{{ base.paragraphs(content.paragraphs) }}
{% if content.closing %}<p class="closing">{{ content.closing }}</p>{% endif %}
<p class="signature">{{ base.words(name, "w") }}</p>
</div>
{% endblock %}
