{#- columns-header, the letter: the CV's header, the name and the headline over the contact
    lines in three columns, then the date, the recipient, the subject, the salutation, the
    paragraphs, the closing and the name. -#}
{% extends "_base/page.html.j2" %}
{% import "_base/macros.html.j2" as base with context %}
{% block body %}
<header class="head">
<div class="headtext">
<h1 class="name">{% for word in name.split() %}<span class="word">{{ word }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h1>
{% if content.headline %}<p class="headline">{{ content.headline }}</p>{% endif %}
</div>
{{ base.portrait() }}
</header>
{{ base.contact_lines() }}

<div class="letter-body">
{{ base.letter_date() }}
{% if content.recipient %}<p class="recipient">{{ content.recipient }}</p>{% endif %}
{% if content.subject %}<p class="subject"><strong>{{ base.label("subject") }}</strong> {{ content.subject }}</p>{% endif %}
{% if content.salutation %}<p class="salutation">{{ content.salutation }}</p>{% endif %}
{{ base.paragraphs(content.paragraphs) }}
{% if content.closing %}<p class="closing">{{ content.closing }}</p>{% endif %}
<p class="signature">{% for word in name.split() %}<span class="word">{{ word }}</span>{% if not loop.last %} {% endif %}{% endfor %}</p>
</div>
{% endblock %}
