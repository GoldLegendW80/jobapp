# Copy to .env and fill in. .env is git-ignored and never committed.

# Runtime environment of the api service: development or production
APP_ENV=development
# Signing key for session cookies; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Log level of the api service
LOG_LEVEL=info

# Postgres superuser created by the db container on first start
POSTGRES_USER=jobapp
# Password of that user; use a long random value in production
POSTGRES_PASSWORD=change-me
# Database created on first start
POSTGRES_DB=jobapp
# SQLAlchemy URL used by the api and Alembic; host is the Compose service name
DATABASE_URL=postgresql+psycopg://jobapp:change-me@db:5432/jobapp

# Redis URL for the queue between api and worker; host is the Compose service name
REDIS_URL=redis://redis:6379/0

# ssh alias of the Jetson used by deploy.sh
DEPLOY_HOST=jetson
# Directory on the Jetson that deploy.sh rsyncs the tree into
DEPLOY_DIR=~/jobapp
# Directory on the Jetson where deploy.sh backup writes pg_dump archives
BACKUP_DIR=~/jobapp-backups
