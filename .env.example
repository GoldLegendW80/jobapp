# Copy to .env and fill in. .env is git-ignored and never committed.

# Runtime environment of the api service: development or production
APP_ENV=development
# Signing key for session cookies; generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Log level of the api service
LOG_LEVEL=info

# Postgres superuser created by the db container on first start
POSTGRES_USER=jobapp
# Password of that user; use a long random value in production
POSTGRES_PASSWORD=change-me
# Database created on first start
POSTGRES_DB=jobapp
# SQLAlchemy URL used by the api and Alembic; host is the Compose service name
DATABASE_URL=postgresql+psycopg://jobapp:change-me@db:5432/jobapp

# Host address and port where caddy, the only published service, listens. 127.0.0.1 keeps it
# off the LAN; set HTTP_BIND=0.0.0.0 to reach it from other machines (ask first on the Jetson).
# On the Mac use HTTP_PORT=8080 if port 80 is taken.
HTTP_BIND=127.0.0.1
HTTP_PORT=80

# Redis URL for the queue between api and worker; host is the Compose service name
REDIS_URL=redis://redis:6379/0

# Encryption key of the users' model credentials (agents A1, api/app/agents/crypto.py): 32 random
# bytes, base64. Required when APP_ENV=production (the api and the worker refuse to start
# without it); empty elsewhere disables saving credentials. Generate with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Never change it in place: losing it makes every stored credential unreadable. To rotate, move
# the current value to CREDENTIALS_KEY_PREVIOUS, set a new CREDENTIALS_KEY, restart, run
#   docker compose exec api python -m app.agents.cli rotate
# then remove CREDENTIALS_KEY_PREVIOUS.
CREDENTIALS_KEY=
CREDENTIALS_KEY_PREVIOUS=

# An agent's answer appears in the browser while it is written (api and worker, read by both):
# the worker publishes the text being written to Redis and the run stream relays it. false turns
# all of it off: the answer arrives whole once it is complete, and none of it passes through
# Redis. true when the line is missing.
AGENTS_LIVE_TEXT=true

# Mail (SPEC-mail.md, api/app/mail/). The OAuth client of the Google Cloud project that connects
# a user's Gmail: both lines or neither. Empty: Gmail cannot be connected, nothing else changes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The address Google sends the browser back to, exactly as registered on the OAuth client:
# https://<the app's public name>/api/mail/oauth/callback. Never taken from a request. Empty:
# Gmail cannot be connected.
GOOGLE_OAUTH_REDIRECT_URI=
# Tests only, refused when APP_ENV=production: where a fake Google is (api/tests/mail/
# fake_gmail.py, the service gmailstub of tests/gmail-stub.compose.yml). GOOGLE_AUTH_URL is the
# consent page the browser is sent to; the server calls GOOGLE_TOKEN_BASE_URL and
# GOOGLE_API_BASE_URL. Empty: Google itself. Under APP_ENV=test the three must be set, to
# anything but Google: no test may reach a real account.
GOOGLE_AUTH_URL=
GOOGLE_TOKEN_BASE_URL=
GOOGLE_API_BASE_URL=
# A link or a status change concluded from a mail applies by itself at this confidence or above
# (0.5 to 1), and only under the binding rule; under it, it waits as a proposal.
MAIL_AUTO_APPLY_CONFIDENCE=0.90
# Mails sent per user and per day, and per user, company and day (1 to 2000). Empty: no limit,
# Gmail's own quota is the ceiling.
MAIL_SEND_DAILY_LIMIT=
MAIL_SEND_COMPANY_DAILY_LIMIT=
# Automatic model runs on mail (triage, classification, drafts) per user and per day (0 to 1000).
MAIL_AUTO_RUNS_PER_DAY=100
# The storage ceiling per user: stored messages (100 to 200000) and bytes of mail text (1 MiB to
# 5 GiB; 314572800 is 300 MiB). At the ceiling, unlinked threads stop being stored.
MAIL_STORAGE_MAX_MESSAGES=20000
MAIL_STORAGE_MAX_BYTES=314572800
# Days a row of the send log is kept (30 to 3650). It holds no address and no text.
MAIL_SENDS_KEEP_DAYS=365

# The browser module: browserd's control API (internal network `browsing`) and its shared secret,
# known to the api, the worker and the browser container only (openssl rand -hex 32). Empty: every
# control request is refused and the browser is not available.
BROWSER_URL=http://browser:9300
BROWSER_CONTROL_SECRET=
# Active seconds per lease purpose over the defaults (900 apply, 1800 a person's session), as
# purpose=seconds,purpose=seconds; empty keeps the defaults.
BROWSER_LEASE_MAX_S=
# A lease without input for this many seconds ends (30 to 3600).
BROWSER_IDLE_S=300
# A person's sign in wait, at most (60 to 7200 seconds); it suspends the other timers.
BROWSER_SESSION_MAX_S=1800
# Past this percentage of the container's memory limit browserd closes the newest tab (50 to 99).
BROWSER_MEM_GUARD_PCT=90
# Tests only (refused in production): the sweep's browser sources read fixture pages here.
BROWSER_SOURCES_BASE_URL=

# Documents (SPEC-documents.md, api/app/documents/): CVs and letters. A render: seconds before it
# is stopped (5 to 300), renders one renderer process runs at once (1 to 8), the largest PDF kept
# in bytes (4194304 is 4 MiB).
DOCUMENTS_RENDER_TIMEOUT_S=30
DOCUMENTS_RENDERS_AT_ONCE=1
DOCUMENTS_MAX_PDF_BYTES=4194304
# Versions kept per document besides the frozen and the approved ones (5 to 500).
DOCUMENTS_VERSIONS_KEPT=30
# One writer run: turns (2 to 50), wall time in seconds (30 to 1800), submits (2 to 10).
DOCUMENTS_GENERATION_MAX_TURNS=10
DOCUMENTS_GENERATION_WALL_S=300
DOCUMENTS_MAX_SUBMITS=4
# Automatic generation: runs at once per person (1 to 4), days a first base CV reaches back for
# postings (1 to 365), seconds before the one retry of a failed run (60 to 86400), and the
# defaults of each person's Advanced settings: the fit score threshold (0 to 100) and the safety
# ceiling of automatic generations per day (1 to 500).
DOCUMENTS_AUTO_AT_ONCE=1
DOCUMENTS_AUTO_LOOKBACK_DAYS=30
DOCUMENTS_AUTO_RETRY_AFTER_S=600
DOCUMENTS_MIN_FIT_DEFAULT=70
DOCUMENTS_DAILY_CEILING_DEFAULT=100
# Base CVs per person (1 to 50), passes of a design capture of an uploaded CV (1 to 4).
DOCUMENTS_BASE_CVS_MAX=10
DOCUMENTS_DESIGN_PASSES=2
# The chat of a document: characters of one message (200 to 10000), messages kept (20 to 2000).
DOCUMENTS_CHAT_MAX_CHARS=2000
DOCUMENTS_MESSAGES_KEPT=200

# Apply (SPEC-apply.md, api/app/apply/). APPLY_SUBMIT_ENABLED=false stops every submission at once
# (the kill switch; ./deploy.sh apply pause is the other one). A person's approval is valid for
# APPLY_APPROVAL_TTL_S seconds; Full auto holds each submission APPLY_HOLD_S seconds, with Cancel.
APPLY_SUBMIT_ENABLED=true
APPLY_APPROVAL_TTL_S=86400
APPLY_HOLD_S=900
# Full auto: the safety ceiling of submissions per day (a runaway backstop, the rest goes to the
# review queue), the fit threshold offered when a person turns it on, one application per company
# in APPLY_FULL_AUTO_COMPANY_DAYS days, and the first APPLY_REHEARSALS runs stop before the click.
APPLY_FULL_AUTO_SAFETY_CEILING=30
APPLY_FULL_AUTO_MIN_FIT_DEFAULT=80
APPLY_FULL_AUTO_COMPANY_DAYS=30
APPLY_REHEARSALS=3
# The pace per ATS host for all people together (one address), and LinkedIn Easy Apply's own.
APPLY_HOST_MIN_INTERVAL_S=180
APPLY_HOST_DAILY_MAX=20
APPLY_LINKEDIN_MIN_INTERVAL_S=600
APPLY_LINKEDIN_DAILY_MAX=15
# Waits before the retries of a fill that failed before the click (seconds, comma separated), the
# wait for a person (captcha, sign in) before the lease ends, the days step screenshots are kept.
APPLY_RETRY_DELAYS_S=600,3600
APPLY_NEEDS_PERSON_WAIT_S=1800
APPLY_STEP_SHOTS_KEEP_DAYS=30
# Tests only: the fake ATS forms server (tests/ats_forms_stub.py). Refused in production.
APPLY_STUB_BASE_URL=

# ssh alias of the Jetson used by deploy.sh
DEPLOY_HOST=jetson
# Directory on the Jetson that deploy.sh rsyncs the tree into
DEPLOY_DIR=~/jobapp
# Directory on the Jetson where deploy.sh backup writes pg_dump archives
BACKUP_DIR=~/jobapp-backups
# Retention of those archives, one number for two rules (ops/db.sh): the newest BACKUP_KEEP dumps
# stay, and a dump BACKUP_KEEP days old or more is deleted. 7 when empty. Users are promised that
# a deleted document leaves the server's backups within 7 days: a higher number breaks that
# promise (every backup then prints a warning). In the Jetson's .env it is read by every backup
# run there, the nightly one included; set on the Mac it is sent with ./deploy.sh backup and
# written into the cron line by ./deploy.sh backup-schedule install.
BACKUP_KEEP=

# Tailscale Funnel, the public URL on the Jetson (service tailscale, profile tunnel; never on the
# Mac). Node name in the tailnet, jobapp when empty: the URL is https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=
# One-time auth key from the Tailscale admin console (Settings, Keys), for the first login only.
# Leave empty here; on the Jetson remove it once ./deploy.sh url answers: the login is kept in the
# tsstate volume, and the api and the worker load every key of .env. ./deploy.sh warns while it is
# still set. Never commit a key.
TS_AUTHKEY=
