{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ops/dev-setup.sh)",
      "Bash(ops/dev-setup.sh --skip-jetson)",
      "Bash(ops/agent-test.sh:*)",
      "Bash(python3 .github/scripts/ci_plan_test.py)",
      "Bash(python3 .github/scripts/e2e_groups.py)",
      "Bash(python3 .github/scripts/e2e_groups_test.py)",
      "Bash(tests/dev_setup_test.sh)",
      "Bash(tests/agent_test_test.sh)",
      "Bash(tests/ship_test.sh)",
      "Bash(tests/local_check_test.sh)",
      "Bash(tests/deploy_test.sh)",
      "Bash(tests/env_check_test.sh)",
      "Bash(tests/remote_ops_test.sh)",
      "Bash(pnpm --dir web run typecheck)",
      "Bash(pnpm --dir web run lint)",
      "Bash(pnpm --dir web exec vitest run:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format --check:*)",
      "Bash(uv --native-tls run ruff check:*)",
      "Bash(uv --native-tls run ruff format --check:*)",
      "Bash(pre-commit run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project field-list:*)",
      "Bash(docker ps:*)",
      "Bash(docker system df)",
      "Bash(df -h:*)",
      "Bash(df -g:*)"
    ],
    "ask": [
      "Bash(ops/ship.sh:*)",
      "Bash(ops/local-check.sh:*)",
      "Bash(ops/deploy-checked.sh:*)",
      "Bash(ops/remote.sh:*)",
      "Bash(./deploy.sh:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(ssh jetson:*)",
      "Bash(docker builder prune:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Bash(cat .env:*)",
      "Bash(cat .env.jetson:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git -c core.hooksPath:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * push * -f)",
      "Bash(git commit *--no-verify*)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -C * push *--no-verify*)",
      "Bash(git *core.hooksPath*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network prune:*)",
      "Bash(docker image prune:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh workflow enable:*)"
    ]
  }
}
