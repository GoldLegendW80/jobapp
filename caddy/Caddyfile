# Single entry point of the stack: static React build at /, FastAPI at /api.
# Plain HTTP, two listeners serving the same site (snippet `app`):
#   :80    published on the host loopback (HTTP_BIND:HTTP_PORT). Trusts no proxy: the client is
#          the TCP peer, and any X-Forwarded-For it sends is ignored.
#   :8080  never published, reached only over the Compose network by the tailscale container
#          (Tailscale Funnel, TLS ends there). Trusts private peers, so the real visitor address
#          comes from X-Forwarded-For, which Funnel always sets to the one address it accepted
#          the connection from, replacing whatever the visitor sent (tailscale serve's reverse
#          proxy: Header.Set, and Go's ReverseProxy drops inbound X-Forwarded-* first). No other
#          header is trusted: Cf-Connecting-Ip, X-Real-Ip and the like pass through Funnel
#          untouched, so a visitor could forge them.
# Built into the caddy image by the `caddy` target of web/Dockerfile, which runs caddy validate
# and caddy fmt on it.
{
	# No admin API: the config is baked into the image, so there is nothing to reload live.
	admin off
	auto_https off
	# docker stop waits 10s; finish in-flight requests within that.
	grace_period 8s
	# The body size check below must run before the handle blocks pick a route.
	order error before handle
	# Caddy's own logs (startup, errors) as JSON on stdout.
	log default {
		output stdout
		format json
	}
	# Connection timeouts against slow clients (issue #100). These are the Caddy defaults made
	# shorter: a caller with no session that opens a connection and then sends its headers or its
	# body one slow byte at a time, or a trickle, no longer ties up a connection and the api
	# behind it for a minute at a time.
	#   read_header 10s   headers must arrive within 10s, else the connection is dropped (default
	#                     1m). A real client sends them in milliseconds.
	#   read_body_idle 15s 1024   a request body that brings nothing for 15s, OR that never
	#                     sustains 1024 bytes/second averaged from the start, is aborted (default
	#                     1m and no rate, so a trickle of one byte now and then was never cut).
	#                     The deadline resets on real progress and the rate allowance grows with
	#                     the bytes sent, so an honest upload of several MiB on a slow line is
	#                     unaffected (its allowance runs to many minutes); only a stall or a near
	#                     zero trickle is cut.
	#   idle 60s          an idle keep-alive connection waiting for its next request is closed
	#                     after 60s (default 5m). An event stream is an active response, not an
	#                     idle connection, so it is never cut by this (tested).
	# Writes keep their defaults: write_idle stays 1m, no write rate, so a long lived event
	# stream (a heartbeat well inside a minute) is never cut. These must be set per server: a
	# `servers` block with an address replaces the global one rather than merging, so the same
	# timeouts appear in the :8080 block below. The published :80 listener takes them from here.
	servers {
		timeouts {
			read_header 10s
			read_body_idle 15s 1024
			idle 60s
		}
	}
	# Tunnel listener only. Every container of the Compose network is a private peer; tailscale is
	# the only one that connects here. Strict: X-Forwarded-For is read right to left and the first
	# untrusted address wins, so even a list could not put a visitor's value first. The timeouts
	# above are repeated here because this block replaces the global `servers` one for :8080.
	servers :8080 {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_header 10s
			read_body_idle 15s 1024
			idle 60s
		}
	}
}

# Response headers of every answer, normal or error.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The app is never framed by another site. When the browser module adds /vnc and the app
		# embeds it in an iframe of its own, relax both to SAMEORIGIN and frame-ancestors 'self'.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(app) {
	# Access log, one JSON line per request on stdout. Cookie, Set-Cookie and Authorization are
	# redacted by default. Invite and reset tokens travel in the path (/invite/<token>,
	# /reset/<token>, /api/auth/invites/<token>) and, once such a page calls the api, in the
	# Referer: both are masked so no log line holds a usable link.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(/(?:invites?|reset)/)[^/?#]+" "${1}[redacted]"
			request>headers>Referer regexp "(/(?:invites?|reset)/)[^/?#]+" "${1}[redacted]"
		}
	}

	encode zstd gzip

	# --- request body limits by route class (issue #100) ----------------------------------------
	# The only routes a caller with no session can reach are the public ones under /api/auth/
	# (sign in, sign out, invite or reset link check and accept); their bodies are a few hundred
	# bytes. Capping them small at the edge stops a caller with no session from making the api
	# buffer a large body: fifty stalled 9 MiB logins were enough to reach the api's 512 MiB
	# limit before this. Every other route keeps the default, 10 MiB (raise it per route if an
	# upload needs more, as the document upload does, below or in a later change).
	#
	# Each request matches exactly one request_body (and one error), chosen by a mutually
	# exclusive expression, so a body is capped once. The match is on the raw decoded path with
	# startsWith, not the `path` matcher, which lowercases and cleans the path first: here that is
	# safe because an over-match only tightens the public 64 KiB limit and never loosens the
	# default. A declared Content-Length above the limit is refused with 413 before anything is
	# proxied; a chunked body is cut at the limit while it streams, and the read fails with 413.
	# This block is kept together to ease the merge with the document upload limit of pull
	# request #98, which adds a 20 MiB exception on POST /api/ingestion/documents as a further,
	# mutually exclusive tier between the two here.
	@public_body expression `{http.request.uri.path}.startsWith("/api/auth/")`
	@default_body expression `!({http.request.uri.path}.startsWith("/api/auth/"))`
	request_body @public_body {
		max_size 64KiB
	}
	request_body @default_body {
		max_size 10MiB
	}
	@public_too_large expression `{http.request.uri.path}.startsWith("/api/auth/") && {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 65536`
	@default_too_large expression `!({http.request.uri.path}.startsWith("/api/auth/")) && {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 10485760`
	error @public_too_large 413
	error @default_too_large 413
	# --- end request body limits -----------------------------------------------------------------

	import security_headers

	# Keep the caller's X-Request-ID (64 characters at most, as the api does), else a fresh UUID.
	# The api logs it and echoes it back in the response.
	map {http.request.header.X-Request-ID} {request_id} {
		~^([A-Za-z0-9._:-]{1,64})$ "${1}"
		default {http.request.uuid}
	}
	request_header X-Request-ID {request_id}

	# Liveness of Caddy itself, for the container healthcheck. Answers without touching the api.
	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	# The api keeps its /api prefix. X-Forwarded-Proto and -Host are set by reverse_proxy, and
	# X-Forwarded-For is exactly one address, the client ip resolved above (the TCP peer on :80,
	# Funnel's X-Forwarded-For on :8080), so a value sent by the visitor never reaches the api.
	# On :8080 X-Forwarded-Proto is Funnel's https (the api then sets Secure cookies).
	# A stopped api fails the dial at once and becomes 502.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 3s
			}
		}
	}

	# Reserved for the browser module: noVNC of the headed Chromium.
	# handle /vnc/* {
	# 	reverse_proxy browser:6080
	# }

	# Hashed build output: cached for a year, never revalidated. A missing file is a real 404,
	# never index.html, so a stale chunk fails loudly instead of parsing HTML as JavaScript.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app: an existing file, or index.html for client routes.
	# no-cache makes the browser revalidate index.html on each load, so a deploy is picked up at once.
	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}

	# Errors raised by Caddy itself (missing file, api unreachable, body too large): a short plain
	# text body, the same security headers, and never cached, so a missing /assets file is not
	# remembered for a year.
	handle_errors {
		import security_headers
		header Cache-Control no-store
		respond "{err.status_code} {err.status_text}"
	}
}

:80 {
	import app
}

:8080 {
	import app
}
