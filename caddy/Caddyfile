# Single entry point of the stack: static React build at /, FastAPI at /api.
# Plain HTTP, two listeners serving the same site (snippet `app`):
#   :80    published on the host loopback (HTTP_BIND:HTTP_PORT). Trusts no proxy: the client is
#          the TCP peer, and any X-Forwarded-For it sends is ignored.
#   :8080  never published, reached only over the Compose network by the tailscale container
#          (Tailscale Funnel, TLS ends there). Trusts private peers, so the real visitor address
#          comes from X-Forwarded-For, which Funnel always sets to the one address it accepted
#          the connection from, replacing whatever the visitor sent (tailscale serve's reverse
#          proxy: Header.Set, and Go's ReverseProxy drops inbound X-Forwarded-* first). No other
#          header is trusted: Cf-Connecting-Ip, X-Real-Ip and the like pass through Funnel
#          untouched, so a visitor could forge them.
# Built into the caddy image by the `caddy` target of web/Dockerfile, which runs caddy validate
# and caddy fmt on it. That caddy is built with one module beyond the standard ones,
# github.com/mholt/caddy-ratelimit (free, Apache 2.0), for the `rate_limit` of :8080 below.
{
	# No admin API: the config is baked into the image, so there is nothing to reload live.
	admin off
	auto_https off
	# docker stop waits 10s; finish in-flight requests within that.
	grace_period 8s
	# The body size check below must run before the handle blocks pick a route.
	order error before handle
	# Caddy's own logs (startup, errors) as JSON on stdout.
	log default {
		output stdout
		format json
	}
	# Connection timeouts against slow clients (issue #100), where Caddy's defaults are long:
	#   read_header 10s   request headers must arrive within 10s, else the connection is dropped
	#                     (default 1m). A real client sends them in milliseconds.
	#   idle 60s          a keep-alive connection waiting for its next request is closed after
	#                     60s (default 5m). An event stream is a response being written, not an
	#                     idle connection.
	# Left at Caddy's defaults on purpose:
	#   read_body_idle    1m. Not shortened: the document upload and the paste answer a stalled
	#                     body themselves, after 30s and 60s (SPEC-ingestion.md), and their
	#                     sentence must reach the user first. Not given a minimum rate either:
	#                     with a rate Caddy replaces the idle window by a budget counted from the
	#                     start (the time plus one second per that many bytes), so a body that
	#                     sends much and then stalls would stay far longer than a minute.
	#                     What this minute does NOT do (measured in the review of pull request
	#                     #106, a lone Caddy in front of an upstream that waits): it ended a
	#                     silent body, with 504 at 60s, only when a large part of the declared
	#                     length was still missing (9,000,000 and 300,000 bytes declared); with
	#                     60,000 or 1,000 declared, Caddy did nothing for the 130s and 240s the
	#                     client stayed. So for the small bodies of the public class nothing at
	#                     Caddy ends a silent or trickling body: the api's own times release the
	#                     api (api/app/body_limit.py), and the client's connection to Caddy
	#                     stays for as long as the client likes. A hard ceiling (`read_body`)
	#                     could bound that; it also bounds uploads and must be tried against an
	#                     event stream first, so it is not set here.
	#   write_idle        1m, no rate: an event stream writes a heartbeat every 15s.
	# These are set per server: a `servers` block with an address replaces the global one, it
	# does not merge with it (seen in the adapted config), so the same timeouts are repeated in
	# the :8080 block below. The published :80 listener takes them from here.
	servers {
		timeouts {
			read_header 10s
			idle 60s
		}
	}
	# Tunnel listener only. Every container of the Compose network is a private peer; tailscale is
	# the only one that connects here. Strict: X-Forwarded-For is read right to left and the first
	# untrusted address wins, so even a list could not put a visitor's value first. The timeouts
	# above are repeated here because this block replaces the global `servers` one for :8080.
	servers :8080 {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_header 10s
			idle 60s
		}
	}
}

# Response headers of every answer, normal or error.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		# Only a default: the api sets no-referrer on the mail callback, whose address holds a
		# code, and that must reach the browser.
		?Referrer-Policy strict-origin-when-cross-origin
		# The app is never framed, not even by itself: the live view (/vnc) is a websocket drawn
		# on a canvas of the app's own page (browser B4), not a frame.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(app) {
	# Access log, one JSON line per request on stdout. Cookie, Set-Cookie and Authorization are
	# redacted by default. Invite and reset tokens travel in the path (/invite/<token>,
	# /reset/<token>, /api/auth/invites/<token>) and, once such a page calls the api, in the
	# Referer: both are masked so no log line holds a usable link. The name of an uploaded
	# document travels in X-Filename (POST /api/ingestion/documents): removed, no log holds it.
	# The `code` and the `state` of Google's answer travel in the query of
	# /api/mail/oauth/callback (mail M4): the whole query of that path is masked, on the same
	# line as the links, because a field takes one filter. The same state also leaves in the
	# Location of the 303 that /api/mail/oauth/start answers (the address of Google's consent
	# page): the value of `state=` is masked there. The callback address can also stay in the tab
	# (a 502 from Caddy, a 500) and then travels as the Referer of the tab icon: the same mask is
	# on the Referer line, and the api's own `Referrer-Policy: no-referrer` on the callback is kept
	# (see security_headers). The live view's one use ticket travels in the query of
	# /vnc/websockify (browser B4): the whole query of that path is masked on the same two lines.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(/(?:invites?|reset)/)[^/?#]+|(/api/mail/oauth/callback|/vnc/websockify)\\?.*" "${1}${2}[redacted]"
			request>headers>Referer regexp "(/(?:invites?|reset)/)[^/?#]+|(/api/mail/oauth/callback|/vnc/websockify)\\?.*" "${1}${2}[redacted]"
			request>headers>X-Filename delete
			resp_headers>Location regexp "([?&]state=)[^&#]+" "${1}[redacted]"
		}
	}

	encode zstd gzip

	# --- request body limits by route class (issues #100 and ingestion G1) ----------------------
	# Three classes, each request in exactly one, so a body is capped once:
	#   public    the routes under /api/auth/ (sign in, sign out, invite or reset link check and
	#             accept, the account routes): 64 KiB. They are the only routes that read a body
	#             from a caller with no session, and such a body is a few hundred bytes. Before
	#             this limit, fifty stalled 9 MiB sign ins reached the api's 512 MiB (issue #100).
	#   upload    the upload of a document (POST /api/ingestion/documents, SPEC-ingestion.md),
	#             which the api itself counts while it reads: 20 MiB.
	#   default   everything else: 10 MiB.
	# How each is matched. The upload is matched as the api routes it: the method, and the decoded
	# path compared as a whole string. The path and path_regexp matchers would not do: they ignore
	# case or clean the path first, so /api/ingestion//documents, which the api answers 404, would
	# get the larger limit. So /api/ingestion/documents/text, a trailing slash, a doubled slash,
	# another case and another method all keep 10 MiB. The public class is a prefix of the same
	# decoded path: it is the smallest limit, so matching too much only tightens. The two cannot
	# both hold, and the default is neither.
	# A declared Content-Length above the limit is refused with 413 before anything is proxied; a
	# chunked body is cut at the limit while it streams, and the read fails with 413. Both rules
	# exist once per class.
	@public_body expression `{http.request.uri.path}.startsWith("/api/auth/")`
	@document_upload expression `{http.request.method} == "POST" && {http.request.uri.path} == "/api/ingestion/documents"`
	@default_body expression `!({http.request.uri.path}.startsWith("/api/auth/")) && !({http.request.method} == "POST" && {http.request.uri.path} == "/api/ingestion/documents")`
	request_body @public_body {
		max_size 64KiB
	}
	request_body @document_upload {
		max_size 20MiB
	}
	request_body @default_body {
		max_size 10MiB
	}
	@public_too_large expression `{http.request.uri.path}.startsWith("/api/auth/") && {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 65536`
	@document_too_large expression `{http.request.method} == "POST" && {http.request.uri.path} == "/api/ingestion/documents" && {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 20971520`
	@default_too_large expression `!({http.request.uri.path}.startsWith("/api/auth/")) && !({http.request.method} == "POST" && {http.request.uri.path} == "/api/ingestion/documents") && {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 10485760`
	error @public_too_large 413
	error @document_too_large 413
	error @default_too_large 413
	# --- end request body limits -----------------------------------------------------------------

	import security_headers

	# Keep the caller's X-Request-ID (64 characters at most, as the api does), else a fresh UUID.
	# The api logs it and echoes it back in the response.
	map {http.request.header.X-Request-ID} {request_id} {
		~^([A-Za-z0-9._:-]{1,64})$ "${1}"
		default {http.request.uuid}
	}
	request_header X-Request-ID {request_id}

	# Liveness of Caddy itself, for the container healthcheck. Answers without touching the api.
	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	# The api keeps its /api prefix. X-Forwarded-Proto and -Host are set by reverse_proxy, and
	# X-Forwarded-For is exactly one address, the client ip resolved above (the TCP peer on :80,
	# Funnel's X-Forwarded-For on :8080), so a value sent by the visitor never reaches the api.
	# On :8080 X-Forwarded-Proto is Funnel's https (the api then sets Secure cookies).
	# A stopped api fails the dial at once and becomes 502.
	# The live view's check is for Caddy's forward_auth alone (below, /vnc/websockify).
	@live_auth path /api/browser/live/auth /api/browser/live/auth/
	handle @live_auth {
		respond 404
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 3s
			}
		}
	}

	# The live view (browser B4): the websocket of the noVNC client to browserd's live port, and
	# nothing else of the browser container (its control API and its proxy stay unreachable).
	# Caddy asks the api first: forward_auth sends the request's cookie, Origin and address
	# (X-Forwarded-Uri, with the one use ticket) to GET /api/browser/live/auth, which answers 204
	# with X-Live-Grant, copied onto the request to browserd, or 401 and 403, which end it here.
	# A grant sent by the visitor is removed first, so only the api's reaches browserd. The check
	# itself is for Caddy alone: from outside, /api/browser/live/auth is a 404 (above). No VNC port
	# exists: browserd starts one x11vnc per admitted viewer (browser/browserd/live.py).
	@live path /vnc/websockify
	# `route` keeps the order as written: Caddy's own order runs forward_auth before
	# request_header, which would delete the api's grant instead of the visitor's.
	handle @live {
		route {
			request_header -X-Live-Grant
			# The check is a plain GET: without the websocket's Upgrade the api answers it as
			# HTTP (with it, uvicorn would take it for a websocket the api has no route for).
			forward_auth api:8000 {
				uri /api/browser/live/auth
				copy_headers X-Live-Grant
				header_up X-Forwarded-For {client_ip}
				header_up -Upgrade
				header_up -Connection
				transport http {
					dial_timeout 3s
				}
			}
			reverse_proxy browser:6080 {
				transport http {
					dial_timeout 3s
				}
			}
		}
	}
	handle /vnc/* {
		respond 404
	}

	# Hashed build output: cached for a year, never revalidated. A missing file is a real 404,
	# never index.html, so a stale chunk fails loudly instead of parsing HTML as JavaScript.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app: an existing file, or index.html for client routes.
	# no-cache makes the browser revalidate index.html on each load, so a deploy is picked up at once.
	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}

	# Errors raised by Caddy itself (missing file, api unreachable, body too large): a short plain
	# text body, the same security headers, and never cached, so a missing /assets file is not
	# remembered for a year.
	# A 429 of the password door's rate limit (:8080, below) answers in the api's own shape, so
	# every page shows its sentence as it shows the api's (web/src/lib/api.ts reads `detail`).
	handle_errors {
		import security_headers
		header Cache-Control no-store
		@address_limited expression `{err.status_code} == 429 && {http.rate_limit.exceeded.name} == "password_address"`
		@door_limited expression `{err.status_code} == 429 && {http.rate_limit.exceeded.name} == "password_door"`
		header @address_limited Content-Type application/json
		header @door_limited Content-Type application/json
		respond @address_limited `{"detail":"Too many password attempts from this connection. Try again in a minute or two."}` 429
		respond @door_limited `{"detail":"The server is busy. Try again in a moment."}` 429
		respond "{err.status_code} {err.status_text}"
	}
}

# --- the password door's rate limit (issue #152, owner decision 2026-10-21) --------------------
# The three routes that check a password with no session to vouch for the caller: sign in, the
# password change and the acceptance of an invite or reset link (POST only, the decoded path
# compared as the api routes it, as the upload class above). Every one takes one of the api's 2
# argon2 slots (SPEC-identity.md, "Password checks at once"); nothing else is limited here.
# Two zones, the address's first, then the door's: a request refused by the first never counts
# in the second, so one address cannot spend the budget of everyone. Each zone is a handler of
# its own, in that order as written: the zones of one handler are sorted by the module, most
# permissive first, which would let one address fill the door (tests/tailscale_test.sh).
#   password_address  2 per 90 seconds per address ({client_ip}: Funnel's X-Forwarded-For on
#                     :8080), an IPv6 address counted by its /64 and an IPv4 mapped address as its
#                     IPv4, as the api counts them. 2 per 90s is the api's own 20 per 15 minutes
#                     per address, but counted for every request, the refused and the served,
#                     where the api counts only the passwords it tested. A person who mistypes
#                     once retries at once; a third try waits out the 90 seconds.
#   password_door     15 per 3 seconds for all addresses together: what the 2 slots empty in
#                     the 3 second wait the api allows, at the 375 ms a check is assumed to take
#                     with two running (2 x 3000 / 375 = 16, kept under the 16 waiting places).
#                     So a flood never fills the api's queue: the api keeps its threads, its
#                     database connections and its memory for people already signed in, and
#                     the excess is refused here, before the api, at no cost to it. On the
#                     Jetson, with T the measured milliseconds of one check with two running,
#                     the figure is floor(2 x 3000 / T), at most 16 (issue #152, the owner's
#                     measurement).
# What it does not do, stated plainly: tell a distributed flood from people. While one lasts,
# sign in, the password change and link acceptance through Funnel answer 429 instead of 503;
# holding the door shut takes about as many addresses as before (the door's rate over one
# address's, 5 per second over 2 per 90 seconds, about 225 at once), and costs the api nothing.
# Both answers carry Retry-After (the module's) and the api's error shape, {"detail": ...}, from
# handle_errors in the `app` snippet. Only on :8080, the listener Funnel reaches: :80 is
# published on the host loopback alone (HTTP_BIND), where every caller is one address, the
# Jetson itself or the gate's journeys, which sign in far more often than 2 per 90 seconds.
# Memory: one key per address seen in the last 90 seconds (plus up to the 15 seconds between two
# sweeps, `sweep_interval`), dropped once its events are older than the window. `disable_metrics`
# is not optional: the module's metrics carry the key as a label, a counter and a histogram per
# address that no sweep ever drops, and with them a flood of 150,000 fresh IPv6 /64s killed a
# caddy held to its 128m (compose.yml) for lack of memory. Without them, the same flood (about
# 800 a second for three minutes) left it running near its limit, every request answered
# (measured on the development Mac, issue #152; the Jetson's figure is the owner's to take).
(password_door_limit) {
	@password_check expression `{http.request.method} == "POST" && ({http.request.uri.path} == "/api/auth/login" || {http.request.uri.path} == "/api/auth/password" || {http.request.uri.path}.matches("^/api/auth/invites/[^/]+/accept$"))`
	rate_limit @password_check {
		zone password_address {
			key {client_ip}
			ipv4_prefix 32
			ipv6_prefix 64
			events 2
			window 90s
		}
		sweep_interval 15s
		disable_metrics
	}
	rate_limit @password_check {
		zone password_door {
			key password_door
			events 15
			window 3s
		}
		disable_metrics
	}
}

:80 {
	import app
}

:8080 {
	import password_door_limit
	import app
}
