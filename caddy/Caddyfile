# Single entry point of the stack: static React build at /, FastAPI at /api.
# Plain HTTP, two listeners serving the same site (snippet `app`):
#   :80    published on the host loopback (HTTP_BIND:HTTP_PORT). Trusts no proxy: the client is
#          the TCP peer, and any X-Forwarded-For or Cf-Connecting-Ip it sends is ignored.
#   :8080  never published, reached only over the Compose network by cloudflared (quick tunnel,
#          TLS ends at Cloudflare). Trusts private peers, so the real visitor address comes from
#          Cf-Connecting-Ip, which the Cloudflare edge always overwrites.
# Built into the caddy image by the `caddy` target of web/Dockerfile, which runs caddy validate
# and caddy fmt on it.
{
	# No admin API: the config is baked into the image, so there is nothing to reload live.
	admin off
	auto_https off
	# docker stop waits 10s; finish in-flight requests within that.
	grace_period 8s
	# The body size check below must run before the handle blocks pick a route.
	order error before handle
	# Caddy's own logs (startup, errors) as JSON on stdout.
	log default {
		output stdout
		format json
	}
	# Tunnel listener only. Every container of the Compose network is a private peer; cloudflared is
	# the only one that connects here.
	servers :8080 {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

# Response headers of every answer, normal or error.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The app is never framed by another site. When the browser module adds /vnc and the app
		# embeds it in an iframe of its own, relax both to SAMEORIGIN and frame-ancestors 'self'.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(app) {
	# Access log, one JSON line per request on stdout. Cookie and Authorization are redacted by default.
	log {
		output stdout
		format json
	}

	encode zstd gzip

	# Largest request body accepted anywhere, 10 MiB; raise it per route if uploads need more.
	# A declared Content-Length above it is refused with 413 before anything is proxied; a chunked
	# body is cut at the limit while it streams, and the read fails with 413.
	request_body {
		max_size 10MiB
	}
	@body_too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 10485760`
	error @body_too_large 413

	import security_headers

	# Keep the caller's X-Request-ID (64 characters at most, as the api does), else a fresh UUID.
	# The api logs it and echoes it back in the response.
	map {http.request.header.X-Request-ID} {request_id} {
		~^([A-Za-z0-9._:-]{1,64})$ "${1}"
		default {http.request.uuid}
	}
	request_header X-Request-ID {request_id}

	# Liveness of Caddy itself, for the container healthcheck. Answers without touching the api.
	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	# The api keeps its /api prefix. X-Forwarded-Proto and -Host are set by reverse_proxy, and
	# X-Forwarded-For is exactly one address, the client ip resolved above (the TCP peer on :80,
	# Cf-Connecting-Ip on :8080), so a value sent by the visitor never reaches the api.
	# A stopped api fails the dial at once and becomes 502.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
			transport http {
				dial_timeout 3s
			}
		}
	}

	# Reserved for the browser module: noVNC of the headed Chromium.
	# handle /vnc/* {
	# 	reverse_proxy browser:6080
	# }

	# Hashed build output: cached for a year, never revalidated. A missing file is a real 404,
	# never index.html, so a stale chunk fails loudly instead of parsing HTML as JavaScript.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app: an existing file, or index.html for client routes.
	# no-cache makes the browser revalidate index.html on each load, so a deploy is picked up at once.
	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}

	# Errors raised by Caddy itself (missing file, api unreachable, body too large): a short plain
	# text body, the same security headers, and never cached, so a missing /assets file is not
	# remembered for a year.
	handle_errors {
		import security_headers
		header Cache-Control no-store
		respond "{err.status_code} {err.status_text}"
	}
}

:80 {
	import app
}

:8080 {
	import app
}
