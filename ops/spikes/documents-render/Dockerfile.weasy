# D1 spike, throwaway (deleted by D3): a build of the worker image plus WeasyPrint, tagged
# d1spike-weasy, never jobapp-*. Built FROM the image the parser service runs (jobapp-worker:latest
# on the Jetson), so the size it adds is this image's size minus that one. The sandbox's main.py
# is the repository's with three lines added by tests/documents_render_jetson.sh: the kinds
# render_pdf and render_pdf_strict in HANDLERS, and RLIMIT_NPROC 32 for render_pdf (Pango starts a
# thread). render_pdf.py goes beside it.
ARG BASE=jobapp-worker:latest
FROM ${BASE}
USER root
# WeasyPrint's system libraries (Pango, HarfBuzz subset, fontconfig) and one free font family for
# the installed font case. The fontconfig cache is built here, into the image: the parser's root
# is read only and its children may not grow a file.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f \
    && pip --python /app/.venv/bin/python install --no-cache-dir weasyprint==66.0
COPY main.py render_pdf.py /app/app/ingestion/sandbox/
USER app:app
