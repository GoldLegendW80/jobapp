# D1 spike, throwaway (deleted by D3): Playwright's Chromium headless shell for linux arm64, the
# shape a `renderer` service would take. Tagged d1spike-chromium.
ARG BASE=python:3.12.15-slim-trixie
FROM ${BASE}
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN pip install --no-cache-dir playwright==1.55.0 pypdf==6.20.1 \
    && playwright install --with-deps --only-shell chromium \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10003 renderer \
    && useradd --system --uid 10003 --gid renderer --no-create-home --home-dir /tmp --shell /usr/sbin/nologin renderer
USER renderer
